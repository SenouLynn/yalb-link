{
  "name": "yalb-gcs-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node --experimental-strip-types node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config src stories .storybook",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "maplibre-gl": "^5.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.8.1",
    "happy-dom": "^20.14.0",
    "storybook": "^10.6.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
