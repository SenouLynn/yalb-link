load("@gazelle//:def.bzl", "gazelle")

# buf is the only protobuf generator. Generated Go is committed to internal/gen
# and compiled by Bazel like any other source. Without this directive gazelle
# emits proto_library + go_proto_library rules that claim the same importpath as
# the buf output — two generators racing for one package.
# gazelle:proto disable_global

# gazelle:prefix yalb.gcs

# Gazelle is Go-only here; frontend/BUILD.bazel is maintained separately.
# gazelle:exclude frontend

gazelle(name = "gazelle")
