load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_binary(
    name = "gcs",
    embed = [":gcs_lib"],
    importpath = "yalb.gcs/cmd/gcs",
    visibility = ["//visibility:public"],
)

go_library(
    name = "gcs_lib",
    srcs = ["main.go"],
    importpath = "yalb.gcs/cmd/gcs",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/bridge",
        "//internal/codec",
        "//internal/routes",
        "//internal/stream",
        "@com_github_bluenviron_gomavlib_v3//:gomavlib",
        "@org_golang_x_sync//errgroup",
    ],
)
