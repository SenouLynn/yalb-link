module(
    name = "yalb_gcs",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")

# Pinned SDK, not go_sdk.host(). ADR-0001 asks for determinism with no implicit
# dependency on ambient environment state; host() makes the build depend on
# whatever Go happens to be installed. Keep this version in step with go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")

# Go module dependencies are resolved from go.mod — go.mod stays the single
# source of truth for versions. After adding a dependency there, run
# `bazel mod tidy` to regenerate the use_repo list below.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_connectrpc_connect", "org_golang_google_protobuf")

# --- frontend ---------------------------------------------------------------
# ADR-0001 asks for one build system across all languages. pnpm-lock.yaml stays
# the source of truth for JS dependency versions, exactly as go.mod does for Go;
# npm_translate_lock reads it rather than duplicating versions here.

bazel_dep(name = "aspect_rules_js", version = "3.4.0")
bazel_dep(name = "aspect_rules_ts", version = "3.10.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//frontend:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version_from = "//frontend:package.json")
use_repo(rules_ts_ext, "npm_typescript")
