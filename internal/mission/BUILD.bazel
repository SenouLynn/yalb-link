load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mission",
    srcs = [
        "coordinator.go",
        "http.go",
    ],
    importpath = "yalb.gcs/internal/mission",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/codec",
        "//internal/gen/gcs/v1:gcs",
        "//internal/routes",
        "//internal/vehicle",
        "@com_github_bluenviron_gomavlib_v3//pkg/message",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "mission_test",
    timeout = "short",
    srcs = [
        "contract_test.go",
        "coordinator_test.go",
        "http_test.go",
        "main_test.go",
    ],
    embed = [":mission"],
    deps = [
        "//internal/codec",
        "//internal/gen/gcs/v1:gcs",
        "//internal/routes",
        "//internal/vehicle",
        "@com_github_bluenviron_gomavlib_v3//:gomavlib",
        "@com_github_bluenviron_gomavlib_v3//pkg/dialects/ardupilotmega",
        "@com_github_bluenviron_gomavlib_v3//pkg/message",
        "@org_uber_go_goleak//:goleak",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
