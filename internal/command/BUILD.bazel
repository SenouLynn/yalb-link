load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "command",
    srcs = ["config.go", "http.go", "policy.go", "registry.go"],
    importpath = "yalb.gcs/internal/command",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/codec",
        "//internal/gen/gcs/v1:gcs",
        "//internal/routes",
        "//internal/vehicle",
        "@com_github_bluenviron_gomavlib_v3//pkg/message",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "command_test",
    srcs = ["http_test.go", "registry_test.go"],
    embed = [":command"],
    deps = [
        "//internal/codec", "//internal/gen/gcs/v1:gcs", "//internal/routes", "//internal/vehicle",
        "@com_github_bluenviron_gomavlib_v3//:gomavlib",
        "@com_github_bluenviron_gomavlib_v3//pkg/dialects/ardupilotmega",
        "@com_github_bluenviron_gomavlib_v3//pkg/message",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)
